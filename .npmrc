# The Node major is a capability, not a preference.
#
# package.json `engines` is advisory: npm ignores it unless this is set. Local runs were
# on Node 20.20.2 while .nvmrc, engines and CI all named a later major, and FOUNDATION §2
# records that Node 20 passed end-of-life in April 2026. Every gate in the Epic A audit
# was run on a forbidden runtime and nothing said so.
#
# `npm ci` now refuses rather than warning. 01-VALIDATION-REPORT §13.
#
# This is a floor, and a floor cannot catch a machine running a LATER major than the pin —
# which is the local/CI split that actually happened. scripts/check-node-version.mjs is
# what makes the running process, .nvmrc, engines and ci.yml agree on one major.
engine-strict=true
