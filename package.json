{
  "name": "gridsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:colors": "node scripts/check-no-hardcoded-colors.mjs",
    "lint:secrets": "node scripts/check-service-role-key.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:theme": "node scripts/check-theme-flash.mjs",
    "check:axe": "node scripts/check-axe.mjs",
    "check:lhci": "lhci autorun --config=lighthouserc.cjs",
    "verify": "npm run typecheck && npm run lint && npm run lint:colors && npm run lint:secrets && npm run check:contrast"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.26",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
