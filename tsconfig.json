{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // The `sanity/schemas` tree is imported by exactly two consumers, and neither is webpack:
    // the Studio (Vite, which resolves explicit extensions) and `scripts/check-schemas.mjs`
    // (Node's type stripping, which REQUIRES them on relative imports). Next never sees the
    // tree — the app reads Sanity over HTTP via `lib/sanity/client.ts`. Without this flag the
    // gate cannot import the schema at all and would have to regex the source, which cannot
    // call a validation function and so cannot assert SC-6.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
