# Which Sanity dataset the build reads. `development` holds seed, placeholder and test
# content; `production` holds live website content only. Both are public — no read token.
#
# REQUIRED, with no default (M-P1-2). An unset variable is a build error, not a fallback to
# `development` — on a live host that fallback would publish a [SEED] VAT number. Set this to
# `production` at Stage 8 and not before. `check:launch` refuses a `production` dataset whose
# VAT number is empty, whose fields carry [SEED], or which has published seed documents.
NEXT_PUBLIC_SANITY_DATASET=development

# Write token for `npm run seed:company`, and for nothing else. Lives in .env.local, which
# is gitignored. Never read by the build, never printed, never committed.
SANITY_API_WRITE_TOKEN=

# A-09 analytics — REMOVED at round 10, and the variables with them. The owner took OQ-7
# option 2: GA4 and PostHog loaded on consent and never initialised, so consent was being
# collected for two libraries that recorded nothing while every accepting visitor's IP and
# user-agent still reached Google and PostHog. lib/analytics/load.ts is deleted; setting
# NEXT_PUBLIC_GA4_ID or NEXT_PUBLIC_POSTHOG_KEY now does nothing at all.
#
# Do not re-add them here on their own. Re-introducing analytics has prerequisites and is a
# single deliberate task — docs/_shared/BEFORE-LAUNCH.md §"Analytics".

# A-07, Supabase. Server-only, all three. DIRECT_CONNECTION_STRING carries the database
# password: never NEXT_PUBLIC_, never imported into a client component. `lint:secrets` fails
# on the name in a client chunk AND on the value, and never prints either.
PROJECT_URL=
PUBLISHABLE_KEY=
DIRECT_CONNECTION_STRING=

# A-08 notifications. Unset is a SKIP; set-but-broken is a FAILURE — a provider nobody has
# configured must not fail a build, and one that has been configured and stopped working must
# not pass silently. Server-only, none of them NEXT_PUBLIC_.
#
# Development sends from onboarding@resend.dev, Resend's shared sender, which only delivers to
# the account owner's own address. A green dev run proves the pipeline, NOT deliverability.
#
# At deployment: sender becomes notifications@gridsmith.uk, and Resend's SPF include: must be
# MERGED into gridsmith.uk's existing record. A domain may have one SPF record; a second is a
# permerror (RFC 7208 4.5) and silently breaks the live site's mail.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM=
LEAD_NOTIFICATION_EMAIL=
SLACK_LEADS_WEBHOOK=
