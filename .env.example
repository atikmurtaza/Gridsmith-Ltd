# Which Sanity dataset the build reads. `development` holds seed, placeholder and test
# content; `production` holds live website content only. Both are public — no read token.
#
# REQUIRED, with no default (M-P1-2). An unset variable is a build error, not a fallback to
# `development` — on a live host that fallback would publish a [SEED] VAT number. Set this to
# `production` at Stage 8 and not before. `check:launch` refuses a `production` dataset whose
# VAT number is empty, whose fields carry [SEED], or which has published seed documents.
NEXT_PUBLIC_SANITY_DATASET=development

# Write token for `npm run seed:company`, and for nothing else. Lives in .env.local, which
# is gitignored. Never read by the build, never printed, never committed.
SANITY_API_WRITE_TOKEN=

# A-09. Required — `check:axe` fails rather than skipping if neither is set, because an
# unconfigured environment is where the grant-path assertion would go hollow. Development
# values live in .env.local; live values go in the platform environment at launch. Same
# variable names, different values per environment. CI uses shaped placeholders.
#
# Neither is a secret: a GA4 measurement id and a PostHog *project* key ship in the client
# bundle on every site that uses them and cannot read data.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud, asserted and not defaulted. PostHog's documented default is us.i.posthog.com; a
# UK site posting behavioural data there is a UK GDPR Chapter V transfer, and the failure is
# silent because everything works and only the jurisdiction is wrong.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# A-07, Supabase. Server-only, all three. DIRECT_CONNECTION_STRING carries the database
# password: never NEXT_PUBLIC_, never imported into a client component. `lint:secrets` fails
# on the name in a client chunk AND on the value, and never prints either.
PROJECT_URL=
PUBLISHABLE_KEY=
DIRECT_CONNECTION_STRING=
