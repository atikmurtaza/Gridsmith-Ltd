# Which Sanity dataset the build reads. `development` holds seed, placeholder and test
# content; `production` holds live website content only. Both are public — no read token.
#
# REQUIRED, with no default (M-P1-2). An unset variable is a build error, not a fallback to
# `development` — on a live host that fallback would publish a [SEED] VAT number. Set this to
# `production` at Stage 8 and not before. `check:launch` refuses a `production` dataset whose
# VAT number is empty, whose fields carry [SEED], or which has published seed documents.
NEXT_PUBLIC_SANITY_DATASET=development

# Write token for `npm run seed:company`, and for nothing else. Lives in .env.local, which
# is gitignored. Never read by the build, never printed, never committed.
SANITY_API_WRITE_TOKEN=

# A-09. Absent today (Q-M19), and absent is correct: with no id the consent-gated loader
# injects nothing even after a grant, and a placeholder would send real visitor data to a
# property nobody owns. Setting either enables injection on grant only.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
